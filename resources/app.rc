#include <windows.h>
#include <commctrl.h>
#include "library_ids.h"

101 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,0,0
 PRODUCTVERSION 1,4,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "CrystalLens Project"
            VALUE "FileDescription", "CrystalLens Crystal Structure Viewer"
            VALUE "FileVersion", "1.4.0.0"
            VALUE "InternalName", "CrystalLens"
            VALUE "LegalCopyright", "Copyright (c) 2026 CrystalLens Project"
            VALUE "OriginalFilename", "CrystalLens.exe"
            VALUE "ProductName", "CrystalLens"
            VALUE "ProductVersion", "1.4.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_LIBRARY DIALOGEX 0, 0, 350, 252
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Crystal library"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_LIBRARY_SEARCH, 9, 8, 254, 15, ES_AUTOHSCROLL | WS_TABSTOP
    RTEXT "", IDC_LIBRARY_COUNT, 266, 11, 74, 12
    LTEXT "", IDC_LIBRARY_HINT, 9, 29, 332, 15
    CONTROL "", IDC_LIBRARY_LIST, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER, 9, 45, 332, 178
    DEFPUSHBUTTON "Open", IDOK, 226, 230, 56, 15
    PUSHBUTTON "Cancel", IDCANCEL, 286, 230, 55, 15
END

IDD_ELEMENT_STYLE DIALOGEX 0, 0, 245, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Element color and size"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Element", IDC_ELEMENT_LABEL, 10, 13, 86, 12
    COMBOBOX IDC_ELEMENT_LIST, 98, 10, 136, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Choose color...", IDC_ELEMENT_COLOR, 10, 37, 84, 16
    CONTROL "", IDC_ELEMENT_SWATCH, "Static", SS_OWNERDRAW, 98, 39, 24, 12
    LTEXT "", IDC_ELEMENT_HEX, 130, 39, 98, 12
    LTEXT "Display radius (%)", IDC_RADIUS_LABEL, 10, 66, 86, 12
    EDITTEXT IDC_ELEMENT_RADIUS, 98, 62, 44, 16, ES_NUMBER | WS_TABSTOP
    LTEXT "25 - 300 %", -1, 150, 65, 80, 12
    PUSHBUTTON "Reset this element", IDC_ELEMENT_RESET, 10, 103, 84, 16
    DEFPUSHBUTTON "OK", IDOK, 123, 103, 52, 16
    PUSHBUTTON "Cancel", IDCANCEL, 182, 103, 52, 16
END

#include "solid_ids.h"

IDD_SOLIDS DIALOGEX 0, 0, 570, 319
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
CAPTION "Polyhedron models"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Model", IDS_PRESET_TITLE, 9, 9, 156, 10
    COMBOBOX IDS_PRESET, 9, 21, 157, 170, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Sides", IDS_N_TITLE, 9, 45, 30, 10
    EDITTEXT IDS_N, 42, 42, 38, 15, ES_NUMBER | WS_TABSTOP
    PUSHBUTTON "Generate", IDS_GENERATE, 87, 42, 79, 16
    AUTOCHECKBOX "Mirror snub model", IDS_MIRROR, 9, 63, 157, 13
    LTEXT "Vertex", IDS_VERTEX_TITLE, 9, 86, 38, 10
    COMBOBOX IDS_VERTEX, 49, 83, 117, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "X", -1, 10, 104, 45, 10
    LTEXT "Y", -1, 63, 104, 45, 10
    LTEXT "Z", -1, 116, 104, 45, 10
    EDITTEXT IDS_X, 9, 116, 50, 15, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDS_Y, 62, 116, 50, 15, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDS_Z, 115, 116, 51, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Apply XYZ", IDS_APPLY, 9, 136, 76, 17
    PUSHBUTTON "Undo edit", IDS_UNDO, 90, 136, 76, 17
    LTEXT "Appearance", IDS_LOOK_TITLE, 9, 167, 157, 10
    COMBOBOX IDS_MODE, 9, 180, 157, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Show vertices", IDS_POINTS, 9, 201, 157, 13
    PUSHBUTTON "Faces", IDS_FACE, 9, 220, 49, 17
    PUSHBUTTON "Edges", IDS_EDGE, 63, 220, 49, 17
    PUSHBUTTON "Backdrop", IDS_BG, 117, 220, 49, 17
    PUSHBUTTON "Fit view", IDS_FIT, 9, 249, 76, 17
    PUSHBUTTON "Restore model", IDS_RESET, 90, 249, 76, 17
    PUSHBUTTON "Open model...", IDS_OPEN, 9, 276, 76, 17
    PUSHBUTTON "Save model...", IDS_SAVE, 90, 276, 76, 17
    CONTROL "", IDS_CANVAS, "CrystalLensSolidCanvas", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 174, 8, 388, 267
    LTEXT "", IDS_STATS, 175, 281, 386, 12
    LTEXT "", IDS_HINT, 175, 297, 386, 17
END
