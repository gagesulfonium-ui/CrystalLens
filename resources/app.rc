#include <windows.h>
#include <commctrl.h>
#include "library_ids.h"

101 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "CrystalLens Project"
            VALUE "FileDescription", "CrystalLens Crystal Structure Viewer"
            VALUE "FileVersion", "1.3.0.0"
            VALUE "InternalName", "CrystalLens"
            VALUE "LegalCopyright", "Copyright (c) 2026 CrystalLens Project"
            VALUE "OriginalFilename", "CrystalLens.exe"
            VALUE "ProductName", "CrystalLens"
            VALUE "ProductVersion", "1.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_LIBRARY DIALOGEX 0, 0, 330, 230
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Crystal library"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_LIBRARY_HINT, 9, 8, 312, 17
    CONTROL "", IDC_LIBRARY_LIST, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER, 9, 26, 312, 174
    DEFPUSHBUTTON "Open", IDOK, 206, 208, 56, 15
    PUSHBUTTON "Cancel", IDCANCEL, 266, 208, 55, 15
END

IDD_ELEMENT_STYLE DIALOGEX 0, 0, 245, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Element color and size"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Element", IDC_ELEMENT_LABEL, 10, 13, 86, 12
    COMBOBOX IDC_ELEMENT_LIST, 98, 10, 136, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Choose color...", IDC_ELEMENT_COLOR, 10, 37, 84, 16
    CONTROL "", IDC_ELEMENT_SWATCH, "Static", SS_OWNERDRAW, 98, 39, 24, 12
    LTEXT "", IDC_ELEMENT_HEX, 130, 39, 98, 12
    LTEXT "Display radius (%)", IDC_RADIUS_LABEL, 10, 66, 86, 12
    EDITTEXT IDC_ELEMENT_RADIUS, 98, 62, 44, 16, ES_NUMBER | WS_TABSTOP
    LTEXT "25 - 300 %", -1, 150, 65, 80, 12
    PUSHBUTTON "Reset this element", IDC_ELEMENT_RESET, 10, 103, 84, 16
    DEFPUSHBUTTON "OK", IDOK, 123, 103, 52, 16
    PUSHBUTTON "Cancel", IDCANCEL, 182, 103, 52, 16
END
